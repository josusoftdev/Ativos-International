// Ativos International — Prisma Schema (D4)
// Banco de dados: PostgreSQL
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Plan ────────────────────────────────────────────────────────────────────
model Plan {
  id          String   @id @default(uuid())
  name        String   @unique        // Ex: "Starter", "Pro", "Enterprise"
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isFree      Boolean  @default(false)
  features    String[] // Lista de features em texto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("plans")
}

// ─── User ────────────────────────────────────────────────────────────────────
model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String  @map("password_hash")
  avatarUrl    String? @map("avatar_url")

  planId String? @map("plan_id")
  plan   Plan?   @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets     Wallet[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// ─── RefreshToken ─────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─── Wallet ──────────────────────────────────────────────────────────────────
model Wallet {
  id     String @id @default(uuid())
  name   String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets WalletAsset[]

  @@unique([userId, name])  // Um usuário não pode ter duas carteiras com o mesmo nome
  @@map("wallets")
}

// ─── WalletAsset ─────────────────────────────────────────────────────────────
model WalletAsset {
  id       String @id @default(uuid())
  symbol   String  // Ex: "BTC", "ETH"
  name     String  // Ex: "Bitcoin", "Ethereum"
  iconUrl  String? @map("icon_url")
  amount   Decimal @db.Decimal(28, 8)   // Quantidade do ativo
  avgPrice Decimal @db.Decimal(20, 8)   // Preço médio de compra (BRL)

  walletId String @map("wallet_id")
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, symbol])  // Cada ativo único por carteira
  @@map("wallet_assets")
}
